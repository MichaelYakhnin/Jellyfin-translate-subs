{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Translator": {
    "MediaPath": "/media",
    "SourceLanguage": "",
    "TargetLanguage": "rus",
    "LibreTranslateUrl": "http://localhost:5000",
    "MaxBatchSize": 50,
    "MaxConcurrency": 2,
    "FileReadyDelayMs": 2000,
    "WebhookProcessingDelayMs": 5000,
    "MaxRetryAttempts": 3,
    "RetryBaseDelayMs": 1000
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5001"
      }
    }
  }
}
